# MesaRPG - Configuración de Producción
# Copia este archivo a .env y modifica los valores

# Dominio del servidor (obligatorio para SSL)
DOMAIN=tu-dominio.com

# Email para Let's Encrypt (notificaciones de renovación)
LETSENCRYPT_EMAIL=admin@tu-dominio.com

# Modo de ejecución
# DEBUG=true habilita los endpoints /api/debug/* (crear personajes de prueba sin
# camara). Dejar en false en cualquier servidor accesible desde fuera de tu red local.
DEBUG=false
PRODUCTION=true

# Configuración del servidor
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# Contraseña de GM (opcional). Si se define, el panel /admin y sus endpoints exigen
# iniciar sesión con esta contraseña (ver /api/admin/login) antes de poder aprobar
# fichas, mover mapas, controlar la cámara, etc. Si se deja sin definir, el admin
# funciona sin login, como hasta ahora - pensado para uso en LAN/casa de confianza.
# Obligatorio en la práctica si vas a desplegar en una IP pública (ver docs/DEPLOY.md).
# GM_SECRET=cambia-esto-por-algo-dificil-de-adivinar

# Orígenes permitidos para CORS, separados por coma. Por defecto "*" (cualquier
# origen), suficiente para LAN/desarrollo. Restringe esto si expones el servidor
# a Internet y sirves algún frontend desde otro dominio.
# CORS_ORIGINS=https://tu-dominio.com

# Persistencia: el estado de partida (fichas, personajes, mapa activo, asignaciones
# de miniaturas) se guarda automáticamente en data/session_state.json en cada cambio;
# no hace falta configurar nada. No hay base de datos real - si en el futuro hace
# falta consultar histórico, ver ROADMAP.md Fase 2 (opción SQLite).

# Límites
MAX_PLAYERS=8
MAX_CONNECTIONS=100
